# Jarvis License Server: settings (copy to /etc/jarvis-license/server.env, chmod 600, owner = the service user).
# Nothing in this file is a secret by itself; the secrets live in the two key files below. NEVER put any of this in the repository.

# the database (SQLite). Back it up with: jarvis-license-server backup /backups/ls-YYYY-MM-DD.sqlite
JARVIS_LS_DB=/var/lib/jarvis-license/licenses.sqlite

# the two secret files, created by `jarvis-license-server init` (mode 600). Back them up OFFLINE.
#  - the signing key (Ed25519): signs the tokens. Its PUBLIC half goes into Jarvis User (JARVIS_LICENSE_PUBKEY).
#  - the pepper: the server keeps only HMAC hashes of keys made with it; losing it makes every issued key unknown.
JARVIS_LS_SIGNING_KEY_FILE=/etc/jarvis-license/signing.key
JARVIS_LS_PEPPER_FILE=/etc/jarvis-license/pepper.key

# listen on the local address only; TLS (https) is done by the reverse proxy in front (Caddy / nginx)
JARVIS_LS_BIND=127.0.0.1:8787
# the header in which the reverse proxy puts the real address of the client (for the limits on guessing). Empty = the socket address.
# Set it ONLY when the proxy overwrites this header (Caddy: X-Forwarded-For is set by the proxy itself).
JARVIS_LS_CLIENT_IP_HEADER=X-Forwarded-For

# how long Jarvis may work without confirming with the server (hours, 1..720). The agreed value: 72.
JARVIS_LS_GRACE_HOURS=72
# how many days a new key may wait for its activation (1..3650); the administrator can set another value for every key
JARVIS_LS_ACTIVATION_DAYS=365
# the text under the tariffs in the renewal window: HOW to pay and get a renewal key (no payment is made inside Jarvis)
JARVIS_LS_RENEW_INFO=Чтобы продлить Jarvis Premium, напишите владельцу продукта, оплатите выбранный тариф и введите полученный ключ продления в этом окне.
